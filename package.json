    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
